# AI Investment Cockpit — durable NON-SECRET configuration.
#
# Copy to `app/.env` and edit. `.env` is gitignored; THIS file is committed as the reference.
# A real environment variable still overrides the file, so a one-off run can override a value
# without editing anything.
#
#   NEVER PUT A SECRET IN HERE. Invariant 4: credentials live in Windows Credential Manager
#   only. Startup FAILS CLOSED (EnvFileSecretError) if a keyring name — or anything shaped
#   like a credential — appears in .env. Store secrets instead with:
#
#       python tools/verify_keys.py --set alpaca_key
#       python tools/verify_keys.py            # report what is provisioned, values never shown
#
#   Secrets the app reads from keyring, NOT from here:
#       alpaca_key  alpaca_secret  finnhub_key  discord_bot_token  cockpit_api_key
#       audit-hmac-key  (minted automatically on first compose)
#
# A scheduled task does not inherit your shell. Point it at an absolute file with
# COCKPIT_ENV_FILE=C:\path\to\app\.env rather than relying on its working directory.

# ---- autonomy ladder -----------------------------------------------------------------
# read_only | paper | review_live | auto_veto | auto_full
# Leave at read_only. The ladder only moves up through measured gates, never by editing this.
COCKPIT_MODE=read_only

# ---- agent provider ------------------------------------------------------------------
# claude | codex. Applies to briefing, triage, grounding, deep proposal drafting, and fresh
# interrogation in human-gated read_only/paper operation. Codex runs with its user config/rules
# ignored, an ephemeral read-only sandbox, and shell/web/apps/browser/computer/MCP features
# disabled. This setting never enables live/auto and never gives a model broker tools.
COCKPIT_DECISION_RUNTIME=claude

# ---- paper research/trading universe --------------------------------------------------
# Comma- or whitespace-separated public-equity symbols. This is static operator config:
# decision models may analyze these names but cannot add/remove symbols at runtime.
# Keep the initial paper universe small enough to review every proposal.
COCKPIT_WATCHLIST=

# ---- operator surface (Discord) ------------------------------------------------------
# Channel IDs are IDs, not credentials — the bot TOKEN is the secret and lives in keyring.
# Your one Discord numeric user ID. Loaded and frozen at startup; approval attempts from every
# other ID fail closed. Multi-operator approval is intentionally outside this solo deployment.
COCKPIT_OPERATOR_IDS=
# Without BRIEF_CHANNEL_ID the morning brief is computed, stored and audited, then delivered
# NOWHERE. This is the value most often lost to an ephemeral shell.
COCKPIT_BRIEF_CHANNEL_ID=
# SEC-11, the P0 pre-live blocker. A PRIVATE #audit-log channel whose ACL DENIES the bot
# manage-messages, so it cannot erase its own witness. Until this is set, the anchor store's
# latest() is None and every gate/mode/budget consult FAILS CLOSED — auto is unreachable.
COCKPIT_AUDIT_LOG_CHANNEL_ID=
COCKPIT_ALERTS_CHANNEL_ID=
COCKPIT_PROPOSALS_CHANNEL_ID=
COCKPIT_SYSTEM_CHANNEL_ID=

# ---- SEC EDGAR (in-process, RW-10) ---------------------------------------------------
# NO API KEY EXISTS OR IS NEEDED. SEC EDGAR is free and unauthenticated; it asks only for a
# declared User-Agent and under 10 req/s. Set this to your own name and a real contact email
# — SEC fair access expects to be able to reach you. A blank UA is refused before any request
# is built, and a suppressed UA is empirically HTTP 403.
COCKPIT_SEC_USER_AGENT=
# Self-chosen floor. The client refuses any value at or above the SEC's 10 req/s ceiling.
COCKPIT_SEC_RATE_LIMIT_PER_SEC=2.0
# COCKPIT_SEC_MAX_RESPONSE_BYTES=33554432
# COCKPIT_SEC_MAX_RUN_BYTES=134217728
# COCKPIT_SEC_MAX_NEW_FILINGS_PER_POLL=25
# COCKPIT_RAW_MIN_FREE_BYTES=268435456

# ---- ingest tuning -------------------------------------------------------------------
# Finnhub's earnings calendar is FULL-MARKET: a 14-day window measured ~1500 entries /
# ~86k tokens on the free tier, and 559 of 659 events in the first live brew were calendar
# rows the relevance filter then discarded. 0 turns the feed OFF entirely.
COCKPIT_CALENDAR_LOOKAHEAD_DAYS=3

# ---- FINRA (enrichment only; currently NOT wired — see docs/refactor-plan.md §5.1 B5) --
# Short interest is ~2 weeks stale on arrival and may never drive urgency. The dataset path
# is console-gated and unverified, so there is no default; the connector refuses to invent
# one. NOTE: setting these is not sufficient — main.run() does not yet pass the OAuth2
# token_provider/http_get closures, so the feed stays unprovisioned regardless.
# COCKPIT_FINRA_ENDPOINT=
# COCKPIT_FINRA_USER_AGENT=
# COCKPIT_FINRA_RATE_PER_SEC=1.0

# ---- congressional copy-trading (RW-16) -----------------------------------------------
# Congressional periodic-transaction reports (House Clerk + Senate EFD). NO API KEY EXISTS
# — both are public .gov sources. Read docs/refactor-plan.md RW-16 before changing a number
# here: a PTR is disclosed up to 45 days AFTER the trade, so this is an AWARENESS feed first
# and a copy engine second, and every knob below bounds what the DETERMINISTIC copy engine
# may do with a signal that is, by construction, weeks old. No model is on this path.
#
# OFF BY DEFAULT, DELIBERATELY: turning it on starts fetching two .gov sites AND starts
# proposing orders. With COCKPIT_CONGRESS_AUTOEXEC left false (the default) the copy CYCLE
# stays operator-triggered and has no scheduler job, exactly as under RW-16.
COCKPIT_CONGRESS_ENABLED=false
# Declared contact string sent as User-Agent on every house.gov / efdsearch.senate.gov
# request. NON-SECRET, same shape and purpose as COCKPIT_SEC_USER_AGENT ("Name
# you@example.com"). Unset => the feed is NOT PROVISIONED and stays silent; it will not
# scrape a .gov host anonymously.
COCKPIT_CONGRESS_USER_AGENT=
# The follow ALLOWLIST: ';'-separated member names ("Pelosi, Nancy; Tuberville, Tommy").
# ';' and not ',' because a comma-separated list tears every "Last, First" in half. EMPTY
# FOLLOWS NOBODY — there is deliberately no "everyone" value. Validated at STARTUP, so a
# misspelled entry fails here rather than becoming a feature that quietly copies no one.
COCKPIT_CONGRESS_FOLLOW=
# Politeness floor in requests/sec. Neither the Clerk nor the EFD publishes a documented
# cap, so this is a limit WE choose, not one we are trusted to respect.
# COCKPIT_CONGRESS_RATE_PER_SEC=0.5
# The Senate EFD provider is separately opt-in: its search UI is agreement-gated and its
# documents are far less machine-readable than the Clerk's.
# COCKPIT_CONGRESS_SENATE_ENABLED=false
#
# --- the copy engine's sizing/staleness bounds (copytrade/policy.py) ---
# Refuse any disclosure whose TRADE is older than this. 45 = the STOCK Act deadline, so the
# default means "act on a filing that arrived on time, refuse one that did not".
# COCKPIT_CONGRESS_MAX_AGE_DAYS=45
# Fraction of the position given up at maximum age, linearly (0.5 => a 45-day-old trade is
# sized at half a same-day one). 0 prices a 44-day-old signal as if it were fresh.
# COCKPIT_CONGRESS_STALENESS_DECAY=0.5
# Fraction of YOUR portfolio value for a baseline (weight 1.0) copied buy.
# COCKPIT_CONGRESS_COPY_FRACTION=0.02
# Hard per-intent ceiling, applied after every other sizing factor. The risk engine has its
# own caps; this one bounds a policy misconfiguration BEFORE it reaches the engine.
# COCKPIT_CONGRESS_MAX_NOTIONAL_PER_TRADE=500
# Below this the intent is DROPPED rather than emitted: a $3 order is all cost and no
# exposure, and it still spends a human approval.
# COCKPIT_CONGRESS_MIN_NOTIONAL_PER_TRADE=25
# Ignore disclosures whose LOW amount bound is under this. The bottom PTR bucket starts at
# $1,001, so the default admits everything.
# COCKPIT_CONGRESS_MIN_AMOUNT_LOW=1001
#
# --- options handling ---
# underlying (translate to a haircut position in the underlying) | ignore (awareness only,
# never act). There is no "copy the contract" value: the risk engine has no options asset
# type, and a hard expiry on the end of a 30-45 day information lag is not a strategy.
# COCKPIT_CONGRESS_OPTIONS_POLICY=underlying
# Options-derived intents are sized at this multiple of an equivalent equity copy — BOTH the
# raw size and the per-trade ceiling, so the clamp cannot erase the discount. Must be >0 and
# <=0.5: the inequality has to survive share quantization (floor(notional/price)) as well as
# hold in dollars, and above 0.5 an options order can collapse onto the equity one. 1 is
# refused outright — that IS copying one for one.
# COCKPIT_CONGRESS_OPTIONS_HAIRCUT=0.25
# Drop an options-derived intent whose disclosed expiry is nearer than this. Must be >=1: at 0
# a 0-DTE contract passes the gate and becomes a fresh multi-week long in the underlying.
# COCKPIT_CONGRESS_OPTIONS_MIN_DAYS_TO_EXPIRY=30
#
# --- exits and the dynamic copy universe ---
# Copy disclosed SALES as exits of positions actually held. ON by default and independent of
# buys on purpose: mirroring only the buys builds a portfolio that never sells.
# COCKPIT_CONGRESS_MIRROR_SELLS=true
# Bounds on the disclosure-promoted universe: how many symbols may be live at once, and how
# long a symbol survives without a fresh disclosure.
# COCKPIT_CONGRESS_MAX_UNIVERSE_SYMBOLS=40
# COCKPIT_CONGRESS_UNIVERSE_TTL_DAYS=120

# ---- RW-17: ZERO-TOUCH PAPER AUTO-EXECUTION (read every line before setting this) -------
# THIS REPLACES YOUR APPROVAL TAP. With it on, a congressional copy trade is NOTIFIED to you,
# waits out a cancel window, and then EXECUTES on the PAPER transport with no action from you.
# Your only lever is /cancel inside that window; you never have to act for a trade to proceed.
#
# PAPER ONLY, BY CONSTRUCTION. This is not an auto rung and it does not arm one. auto_veto /
# auto_full are LIVE modes with their own gates (SEC-11 anchor, weeks of history, adjudicated
# proposals); none of them is touched, and none of them is needed, because this lane runs at
# mode=paper and re-checks that at the instant of every trade. It cannot move real money.
#
# Turning this on with COCKPIT_CONGRESS_ENABLED=false, with an empty COCKPIT_CONGRESS_FOLLOW,
# or with a daily rail below COCKPIT_CONGRESS_MIN_NOTIONAL_PER_TRADE is a STARTUP FAILURE, not
# a quiet no-op — each of those is a lane that boots clean and can never trade, and you would
# be waiting on notifications that were never going to come.
COCKPIT_CONGRESS_AUTOEXEC=false
# How long a queued trade waits, notified, before it fires. Minimum 60s, because that is the
# resolve tick: a window shorter than the tick is not shorter, it is unpredictable. The REAL
# window is this value plus at most one 60s tick — the error always runs in your favour.
# COCKPIT_CONGRESS_AUTOEXEC_WINDOW_SECONDS=300
# How long a queued trade may stay unresolved before it is abandoned by name (`ticket_expired`),
# notified and counted. Most refusals on this lane are TRANSIENT and keep the ticket alive (a
# HALT clears, a breaker is reset, tomorrow's budget is fresh), so without an upper bound a
# ticket queued during a Monday killswitch would still be counting down a Monday-priced order on
# Friday. Must be greater than the cancel window, or startup fails. Default = one session.
# COCKPIT_CONGRESS_AUTOEXEC_TICKET_MAX_AGE_SECONDS=21600
#
# --- the budget rails that REPLACE the human ---
# A human approving each trade was, incidentally, what bounded daily damage. These four are its
# replacement, and their defaults are deliberately tighter than what you would approve by hand.
# Exhausting one is a NAMED, NOTIFIED refusal, never a silent stop.
# Total dollars this lane may commit per trading day (default = one full-size copy trade).
# COCKPIT_CONGRESS_AUTOEXEC_MAX_DAILY_NOTIONAL=500
# How many independent trades per day — a count rail as well as a dollar rail, because each
# trade is its own fill and its own position to unwind.
# COCKPIT_CONGRESS_AUTOEXEC_MAX_TRADES_PER_DAY=3
# The standing bound: how many positions this lane may hold open at once. Without it a daily
# rail still accumulates an unbounded book over a quarter with nobody approving any of it.
# COCKPIT_CONGRESS_AUTOEXEC_MAX_OPEN_POSITIONS=10
# Per-symbol daily concentration, so one name cannot consume the whole day's budget.
# COCKPIT_CONGRESS_AUTOEXEC_MAX_NOTIONAL_PER_SYMBOL_PER_DAY=250

# ---- cross-process brew feed (superseded by RW-10, retired once the in-process path runs)
# COCKPIT_BREW_DB_PATH=
# COCKPIT_BREW_RUNS_DIR=

# ---- operational ---------------------------------------------------------------------
COCKPIT_LOG_LEVEL=INFO
# COCKPIT_API_HOST=127.0.0.1
# COCKPIT_API_PORT=8787

# ---- analysis budget / sensitivity -----------------------------------------------------
# Deep-model daily escalation budget (WP8).
# COCKPIT_DEEP_MODEL_DAILY_BUDGET=5
# Triage escalation sensitivity, 0-100.
# COCKPIT_TRIAGE_THRESHOLD=60

# ---- order-path knobs (WP6/WP7) --------------------------------------------------------
# A live order at/above this notional needs the operator's modal double-confirm (SEC-15).
# COCKPIT_MODAL_CONFIRM_NOTIONAL=1000
# SEC-07 pending-exposure cap: sum(approved-but-unfilled notional) + open must stay at or
# below this inside the locked submit.
# COCKPIT_PENDING_EXPOSURE_CAP=10000
# An approval older than this (measured from RiskDecision eval) voids before submit.
# COCKPIT_APPROVAL_TTL_SECONDS=900

# ---- W11 decision-agent hardening (SEC-05/06) ------------------------------------------
# BOTH DEFAULT TO UNSET, AND UNSET MEANS THE CONTROL IS INACTIVE — not satisfied. Setting
# them is what turns the control on, so they are the two most consequential names in this
# file. Leave them blank for dev.
#
# SEC-05: the separate LOW-PRIVILEGE OS account decision-stage subprocesses run under. When
# set, main.compose() fails closed unless that account provably cannot read the bearer
# stores. See docs/setup/low-priv-agent-account.md.
# COCKPIT_DECISION_AGENT_ACCOUNT=
# SEC-06: the pinned sandbox cwd for decision-agent subprocesses. The runner REFUSES any
# decision job whose cwd differs from this.
# COCKPIT_DECISION_AGENT_CWD=

# ---- SEC-11 external audit witness (W10) -----------------------------------------------
# The git-TRACKED head file the witness anchors. Note: this path is written AND auto-
# committed by bridge/witness.py, so point it OUTSIDE the repo on any branch you intend to
# merge — a lower seq merged in trips AnchorRewind and the system fails closed.
# COCKPIT_AUDIT_HEAD_FILE=data/audit-head.json
