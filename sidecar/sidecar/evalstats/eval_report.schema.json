{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sidecar.eval_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "n_observations", "n_trials", "periods_per_year", "threshold_status", "notes"],
  "properties": {
    "schema_version": {"const": "sidecar.eval_report.v1"},
    "status": {"enum": ["ok", "insufficient_sample", "moment_bound_violated"]},
    "reason": {"type": ["string", "null"]},
    "n_observations": {"type": "integer", "minimum": 0},
    "minimum_observations": {"type": "integer"},
    "n_trials": {"type": "integer", "minimum": 1},
    "periods_per_year": {"type": "integer", "minimum": 1},
    "sr_benchmark": {"type": "string"},
    "mean_return": {"type": "string"},
    "volatility": {"type": "string"},
    "sharpe_per_period": {"type": "string"},
    "sharpe_annualized": {"type": "string"},
    "skewness": {"type": "string"},
    "kurtosis_pearson": {"type": "string"},
    "psr": {"type": ["string", "null"]},
    "dsr": {"type": ["string", "null"]},
    "sr_deflation_threshold": {"type": ["string", "null"]},
    "min_track_record_length": {"type": ["string", "null"]},
    "min_track_record_years": {"type": ["string", "null"]},
    "track_record_confidence": {"type": "string"},
    "drawdown": {"type": "object"},
    "bootstrap": {"type": ["object", "null"]},
    "benchmark": {"type": ["object", "null"]},
    "pbo": {"type": ["object", "null"]},
    "threshold_status": {"const": "not_frozen"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
