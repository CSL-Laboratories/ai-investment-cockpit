{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sidecar.showdown.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "threshold_status",
    "yield_claim",
    "orders_submitted",
    "n_decisions",
    "n_outcomes",
    "n_scored",
    "excluded",
    "cells",
    "direction_hit_rate",
    "reason_happened_rate",
    "by_driver_class",
    "brier",
    "null_brier_constant_half",
    "brier_minus_null",
    "reliability",
    "mean_abs_magnitude_error",
    "n_magnitude",
    "weeks",
    "rows",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "sidecar.showdown.v1"},
    "threshold_status": {"const": "not_frozen"},
    "yield_claim": {"const": false},
    "orders_submitted": {"const": 0},
    "n_decisions": {"type": "integer", "minimum": 0},
    "n_outcomes": {"type": "integer", "minimum": 0},
    "n_scored": {"type": "integer", "minimum": 0},
    "excluded": {"type": "object"},
    "cells": {"type": "object"},
    "direction_hit_rate": {"type": ["number", "null"]},
    "reason_happened_rate": {"type": ["number", "null"]},
    "by_driver_class": {"type": "object"},
    "brier": {"type": ["number", "null"]},
    "null_brier_constant_half": {"type": ["number", "null"]},
    "brier_minus_null": {"type": ["number", "null"]},
    "reliability": {"type": "array"},
    "mean_abs_magnitude_error": {"type": ["number", "null"]},
    "n_magnitude": {"type": "integer", "minimum": 0},
    "weeks": {"type": "array"},
    "rows": {"type": "array"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
