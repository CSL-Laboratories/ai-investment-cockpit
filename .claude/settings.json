{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"'",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
