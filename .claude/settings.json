{
  "permissions": {
    "allow": [
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest)",
      "Bash(python3 -m pytest *)",
      "Bash(ruff check)",
      "Bash(ruff check *)",
      "Bash(../.venv/bin/python -m pytest)",
      "Bash(../.venv/bin/python -m pytest *)",
      "Bash(../.venv/bin/ruff check)",
      "Bash(../.venv/bin/ruff check *)",
      "Bash(python -X utf8 -B tools/test_*.py)",
      "Bash(python3 -X utf8 -B tools/test_*.py)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(cargo clippy)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt --check)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo fmt --manifest-path rust/Cargo.toml --all --check)",
      "Bash(actionlint)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view)",
      "Bash(gh run view *)",
      "mcp__linear__get_issue",
      "mcp__linear__list_issues",
      "mcp__linear__list_comments",
      "mcp__Linear__get_issue",
      "mcp__Linear__list_issues",
      "mcp__Linear__list_comments"
    ],
    "ask": [
      "Bash(gh * -R*)",
      "Bash(gh * --repo*)",
      "Bash(gh *://*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-substitution.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
