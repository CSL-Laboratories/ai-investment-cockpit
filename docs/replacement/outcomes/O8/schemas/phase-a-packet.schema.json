{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cockpit.replacement.o8.phase-a-packet.v1",
  "title": "O8 phase A frozen fixture packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "outcome",
    "phase",
    "linear_issue",
    "maturity",
    "completion_gate_status",
    "not_claimed",
    "source_commit",
    "registry_baseline",
    "per_pr_benchmark_gating",
    "new_ci_cadence",
    "research",
    "disposition",
    "hard_floors",
    "protocol",
    "workloads",
    "candidate",
    "migration",
    "unresolved_decisions"
  ],
  "properties": {
    "schema_id": {"const": "cockpit.replacement.o8.phase-a-packet.v1"},
    "outcome": {"const": "O8"},
    "phase": {"const": "A"},
    "linear_issue": {"const": "CSL-220"},
    "maturity": {"const": "researched"},
    "completion_gate_status": {"const": "pending_outcome_artifact"},
    "not_claimed": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "human_decided"}},
        {"contains": {"const": "contract_frozen"}},
        {"contains": {"const": "prototyped"}},
        {"contains": {"const": "implemented"}},
        {"contains": {"const": "provider_free_verified"}},
        {"contains": {"const": "demo_or_paper_qualified"}},
        {"contains": {"const": "shadow_qualified"}},
        {"contains": {"const": "limited_live_qualified"}},
        {"contains": {"const": "release_qualified"}},
        {"contains": {"const": "PASS"}},
        {"contains": {"const": "qualification"}}
      ]
    },
    "source_commit": {"const": "ebbaa34489f171e079834d02098135711e1d4755"},
    "registry_baseline": {"const": "73ab78d9d69494c757cec875855121b1d29320a4"},
    "per_pr_benchmark_gating": {"const": false},
    "new_ci_cadence": {"const": false},
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel_search_ids", "cited_urls", "retrieved_on", "retrieved_by"],
      "properties": {
        "parallel_search_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cited_urls": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "retrieved_on": {"const": "2026-10-17"},
        "retrieved_by": {"const": "embedded Parallel results run on Dan's box"}
      }
    },
    "disposition": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "disposition", "paths", "compatibility", "evidence"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["retain", "measure", "rework", "replace", "undecided"]},
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "compatibility": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "locator", "statement"],
              "properties": {
                "class": {"enum": ["source_documented_fact", "locally_observed", "inference"]},
                "locator": {"type": "string", "minLength": 1},
                "statement": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "hard_floors": {"type": "array", "minItems": 11, "maxItems": 11},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier1", "tier2", "tier3"],
      "properties": {
        "tier1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "locator",
            "cases",
            "rounds",
            "orderings",
            "noise",
            "regression_rule",
            "fails_linux_gates",
            "process_exit_on_regression",
            "csl42_evidence",
            "per_pr_gating_added"
          ],
          "properties": {
            "status": {"const": "unchanged"},
            "locator": {"const": "app/benchmarks/"},
            "cases": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {"type": "string"}
            },
            "rounds": {"const": 5},
            "orderings": {"const": 2},
            "noise": {"const": "relative_iqr"},
            "regression_rule": {"type": "string", "minLength": 1},
            "fails_linux_gates": {"const": false},
            "process_exit_on_regression": {"const": 0},
            "csl42_evidence": {"const": false},
            "per_pr_gating_added": {"const": false}
          }
        },
        "tier2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_free", "cadence", "per_pr", "workloads"],
          "properties": {
            "provider_free": {"const": true},
            "cadence": {"const": "unresolved_owner_lucas"},
            "per_pr": {"const": false},
            "workloads": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {"type": "string"}
            }
          }
        },
        "tier3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "results_in_this_packet",
            "requires_matched_workloads",
            "requires_floors_in_tests"
          ],
          "properties": {
            "role": {"const": "only_csl42_evidence"},
            "results_in_this_packet": {"const": 0},
            "requires_matched_workloads": {"const": true},
            "requires_floors_in_tests": {"const": true}
          }
        }
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "object"}
    },
    "candidate": {"type": "object"},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "big_bang_deletion",
        "decommission_in_phase_a",
        "facade_is_order_authority",
        "seams",
        "rollback",
        "mixed_version_recovery",
        "shared_stores",
        "anti_corruption_layer"
      ],
      "properties": {
        "pattern": {"const": "strangler_fig"},
        "big_bang_deletion": {"const": false},
        "decommission_in_phase_a": {"const": false},
        "facade_is_order_authority": {"const": false},
        "seams": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}},
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system_of_record",
            "route_back_to_legacy",
            "requires_human_receipt_before_decommission"
          ],
          "properties": {
            "system_of_record": {"const": "legacy_raw_store_and_hash_chain"},
            "route_back_to_legacy": {"const": true},
            "requires_human_receipt_before_decommission": {"const": true}
          }
        },
        "mixed_version_recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation_tag_required",
            "replay_from",
            "on_disagreement",
            "trade_on_disagreement"
          ],
          "properties": {
            "generation_tag_required": {"const": true},
            "replay_from": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"enum": ["raw_inputs", "hash_chain_audit"]}
            },
            "on_disagreement": {"const": "watch_only"},
            "trade_on_disagreement": {"const": false}
          }
        },
        "shared_stores": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"enum": ["raw_bytes", "hash_chain_audit"]}
        },
        "anti_corruption_layer": {"const": true}
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "owner", "status", "question"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {
            "enum": ["spend", "credentials", "tax_legal", "architecture", "release", "live"]
          },
          "owner": {"const": "Lucas"},
          "status": {"const": "unresolved"},
          "question": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
