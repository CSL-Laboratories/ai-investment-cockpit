{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cockpit.replacement.o8.benchmark-manifest.v1",
  "title": "O8 phase A benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "tier",
    "workload_id",
    "provider_free",
    "network_calls",
    "credentials_used",
    "live_orders",
    "csl42_evidence",
    "commit",
    "host",
    "io",
    "helper_processes",
    "variance",
    "observation"
  ],
  "properties": {
    "schema_id": {"const": "cockpit.replacement.o8.benchmark-manifest.v1"},
    "tier": {"enum": [2, 3]},
    "workload_id": {
      "enum": [
        "ingest_to_raw_store",
        "point_in_time_replay",
        "frozen_evaluation_run",
        "paper_order_lifecycle",
        "reconciliation",
        "gui_cli_render"
      ]
    },
    "provider_free": {"const": true},
    "network_calls": {"const": 0},
    "credentials_used": {"const": false},
    "live_orders": {"const": false},
    "csl42_evidence": {"type": "boolean"},
    "floors_attached": {"type": "boolean"},
    "candidate_id": {"type": "string", "minLength": 1},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "workload_id", "fixture_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workload_id": {"type": "string", "minLength": 1},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "python", "status"],
      "properties": {
        "runner": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "status": {"enum": ["required_on_run", "measured"]}
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "kinds", "status"],
      "properties": {
        "included": {"const": true},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["disk", "memory_copy"]}
        },
        "status": {"enum": ["required_on_run", "measured"]}
      }
    },
    "helper_processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "included", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "included": {"const": true},
          "status": {"enum": ["required_on_run", "measured"]}
        }
      }
    },
    "variance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statistic", "repetitions", "relative_iqr", "status"],
      "properties": {
        "statistic": {"const": "relative_iqr"},
        "repetitions": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "relative_iqr": {
          "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
        },
        "status": {"enum": ["required_on_run", "measured"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50",
        "p95",
        "p99",
        "throughput",
        "rss_bytes",
        "cpu",
        "io",
        "tokens",
        "cost",
        "correctness",
        "failure",
        "recovery",
        "growth",
        "status"
      ],
      "properties": {
        "p50": {"type": ["number", "null"]},
        "p95": {"type": ["number", "null"]},
        "p99": {"type": ["number", "null"]},
        "throughput": {"type": ["number", "null"]},
        "rss_bytes": {"type": ["integer", "null"]},
        "cpu": {"type": ["number", "null"]},
        "io": {"type": ["number", "null"]},
        "tokens": {"type": ["number", "null"]},
        "cost": {"type": ["number", "null"]},
        "correctness": {"type": "string", "minLength": 1},
        "failure": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "growth": {"type": "string", "minLength": 1},
        "status": {"enum": ["required_on_run", "measured"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"csl42_evidence": {"const": true}},
        "required": ["csl42_evidence"]
      },
      "then": {
        "properties": {
          "tier": {"const": 3},
          "floors_attached": {"const": true},
          "variance": {
            "properties": {"status": {"const": "measured"}},
            "required": ["status"]
          }
        },
        "required": ["tier", "floors_attached", "variance", "candidate_id", "baseline", "fixture_sha256"]
      }
    },
    {
      "if": {
        "properties": {"variance": {"properties": {"status": {"const": "measured"}}, "required": ["status"]}},
        "required": ["variance"]
      },
      "then": {
        "properties": {
          "variance": {
            "properties": {
              "repetitions": {"type": "integer", "minimum": 2},
              "relative_iqr": {"type": "number"}
            }
          },
          "host": {"properties": {"status": {"const": "measured"}}, "required": ["status"]},
          "io": {"properties": {"status": {"const": "measured"}}, "required": ["status"]},
          "helper_processes": {
            "items": {"properties": {"status": {"const": "measured"}}, "required": ["status"]}
          },
          "observation": {
            "properties": {
              "status": {"const": "measured"},
              "p50": {"type": "number"},
              "p95": {"type": "number"},
              "p99": {"type": "number"},
              "throughput": {"type": "number"},
              "rss_bytes": {"type": "integer"}
            },
            "required": ["status"]
          }
        }
      }
    }
  ]
}
