{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "o2.coverage.schema",
  "title": "O2 frozen coverage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "maturity", "contract_frozen", "synthetic", "observation_ids", "checks"],
  "properties": {
    "schema_version": {"const": "o2.candidate.v1"},
    "maturity": {"const": "researched"},
    "contract_frozen": {"const": false},
    "synthetic": {"const": true},
    "observation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "natural_key", "decision_time", "outcome"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "natural_key": {"type": "string", "minLength": 1},
        "decision_time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "outcome": {"$ref": "#/$defs/outcome"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_raw_record_ids", "hidden_raw_record_ids", "effective_raw_record_id"],
      "properties": {
        "visible_raw_record_ids": {"type": "array", "items": {"type": "string"}},
        "hidden_raw_record_ids": {"type": "array", "items": {"type": "string"}},
        "effective_raw_record_id": {"type": ["string", "null"]},
        "expected_close_time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}
