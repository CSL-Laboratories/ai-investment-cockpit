{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "o2.observation.schema",
  "title": "O2 candidate derived observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "maturity", "contract_frozen", "synthetic", "observations"],
  "properties": {
    "schema_version": {"const": "o2.candidate.v1"},
    "maturity": {"const": "researched"},
    "contract_frozen": {"const": false},
    "synthetic": {"const": true},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "ratio_numerator",
        "ratio_denominator",
        "ex_date",
        "raw_record_id"
      ],
      "properties": {
        "action_type": {"const": "split"},
        "ratio_numerator": {"type": "integer", "minimum": 1},
        "ratio_denominator": {"type": "integer", "minimum": 1},
        "ex_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "raw_record_id": {"type": "string", "pattern": "^raw-[a-z0-9-]{1,64}$"}
      }
    },
    "observation": {
      "oneOf": [
        {"$ref": "#/$defs/equity_observation"},
        {"$ref": "#/$defs/event_observation"}
      ]
    },
    "shared": {
      "type": "object",
      "required": [
        "observation_id",
        "decision_time",
        "market_family",
        "identity_id",
        "natural_key",
        "effective_raw_record_id",
        "raw_record_ids",
        "value"
      ]
    },
    "equity_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "decision_time",
        "market_family",
        "identity_id",
        "natural_key",
        "effective_raw_record_id",
        "raw_record_ids",
        "value",
        "resolution",
        "lifecycle_status",
        "corporate_actions"
      ],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^obs-[a-z0-9-]{1,64}$"},
        "decision_time": {"$ref": "#/$defs/instant"},
        "market_family": {"const": "equity"},
        "identity_id": {"type": "string"},
        "natural_key": {"type": "string"},
        "effective_raw_record_id": {"type": "string"},
        "raw_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "value": {"type": ["string", "null"]},
        "resolution": {"const": null},
        "lifecycle_status": {"const": null},
        "corporate_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "event_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "decision_time",
        "market_family",
        "identity_id",
        "natural_key",
        "effective_raw_record_id",
        "raw_record_ids",
        "value",
        "resolution",
        "lifecycle_status",
        "corporate_actions"
      ],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^obs-[a-z0-9-]{1,64}$"},
        "decision_time": {"$ref": "#/$defs/instant"},
        "market_family": {"const": "event"},
        "identity_id": {"type": "string"},
        "natural_key": {"type": "string"},
        "effective_raw_record_id": {"type": "string"},
        "raw_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "value": {"const": null},
        "resolution": {"enum": ["yes", "no", "scalar", "voided"]},
        "lifecycle_status": {
          "enum": [
            "determined",
            "disputed",
            "amended",
            "finalized",
            "voided"
          ]
        },
        "corporate_actions": {"const": null}
      }
    }
  }
}
