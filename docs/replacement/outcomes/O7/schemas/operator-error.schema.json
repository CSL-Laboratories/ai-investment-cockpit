{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O7 operator error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "status_code", "message", "recovery", "color_only"],
  "properties": {
    "code": {"enum": ["usage", "refused", "stale_or_unreconciled", "unavailable"]},
    "status_code": {"enum": ["usage", "refused", "stale_or_unreconciled", "unavailable"]},
    "message": {"type": "string", "minLength": 1},
    "recovery": {"type": "string", "minLength": 1},
    "color_only": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"code": {"const": "usage"}}, "required": ["code"]}, "then": {"properties": {"status_code": {"const": "usage"}}}},
    {"if": {"properties": {"code": {"const": "refused"}}, "required": ["code"]}, "then": {"properties": {"status_code": {"const": "refused"}}}},
    {"if": {"properties": {"code": {"const": "stale_or_unreconciled"}}, "required": ["code"]}, "then": {"properties": {"status_code": {"const": "stale_or_unreconciled"}}}},
    {"if": {"properties": {"code": {"const": "unavailable"}}, "required": ["code"]}, "then": {"properties": {"status_code": {"const": "unavailable"}}}}
  ]
}
