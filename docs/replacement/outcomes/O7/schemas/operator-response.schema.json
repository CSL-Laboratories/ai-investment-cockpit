{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O7 operator response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "candidate_maturity",
    "surface",
    "command",
    "request_id",
    "profile",
    "enforcement_route",
    "authority_effect",
    "order_path",
    "status_code",
    "visibility",
    "result",
    "errors",
    "presentation"
  ],
  "properties": {
    "api_version": {"const": "o7.operator.v0"},
    "candidate_maturity": {"const": "researched"},
    "surface": {"enum": ["gui", "cli"]},
    "command": {
      "type": "string",
      "enum": [
        "operator.audit.export",
        "operator.budgets.inspect",
        "operator.decisions.inspect",
        "operator.evidence.inspect",
        "operator.export.bundle",
        "operator.health.inspect",
        "operator.interventions.request_reconciliation",
        "operator.interventions.request_revocation",
        "operator.interventions.request_stop",
        "operator.positions.inspect",
        "operator.profiles.inspect",
        "operator.recovery.inspect",
        "operator.strategies.inspect",
        "operator.uncertainty.inspect"
      ]
    },
    "request_id": {"type": "string", "pattern": "^req_[a-z0-9_.:-]{1,80}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_class", "digest", "signature_state"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
        "profile_class": {"enum": ["A", "B", "C"]},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signature_state": {"const": "illustrative_unsigned_fixture"}
      }
    },
    "enforcement_route": {"const": "risk_pass_mode_approval_order_gateway"},
    "authority_effect": {"enum": ["none", "intervention_request"]},
    "order_path": {"const": "none"},
    "status_code": {"enum": ["ok", "usage", "refused", "stale_or_unreconciled", "unavailable"]},
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty", "refusal", "stale_data", "reconciliation"],
      "properties": {
        "uncertainty": {"enum": ["visible", "absent_not_hidden"]},
        "refusal": {"enum": ["visible", "absent_not_hidden"]},
        "stale_data": {"enum": ["visible", "absent_not_hidden"]},
        "reconciliation": {"enum": ["reconciled", "unreconciled_visible"]}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
        "source_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
        "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "raw_ref": {"type": "string", "pattern": "^raw://[a-z0-9_.:-]{1,64}$"},
        "summary_ref": {"type": "string", "pattern": "^summary://[a-z0-9_.:-]{1,64}$"},
        "raw_separated_from_summary": {"const": true},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z_]{1,32}$"}
        },
        "strategy_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
        "qualification": {"enum": ["not_qualified", "qualified"]},
        "baseline_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instrument_id", "venue", "quantity", "currency"],
            "properties": {
              "instrument_id": {"type": "string", "pattern": "^[A-Z0-9.-]{1,32}$"},
              "venue": {"enum": ["stock", "kalshi_demo"]},
              "quantity": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
              "currency": {"const": "USD"}
            }
          }
        },
        "collateral": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "amount", "state"],
          "properties": {
            "currency": {"const": "USD"},
            "amount": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
            "state": {"enum": ["known", "unknown"]}
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "outcome", "reason_code"],
            "properties": {
              "decision_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
              "outcome": {"enum": ["recorded", "refused"]},
              "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"}
            }
          }
        },
        "refusals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "reason_code", "visible"],
            "properties": {
              "decision_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
              "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
              "visible": {"type": "boolean"}
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "state", "visible"],
            "properties": {
              "subject": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
              "state": {"enum": ["known", "unknown", "uncertain"]},
              "visible": {"type": "boolean"}
            }
          }
        },
        "watch_only": {"type": "boolean"},
        "stale": {"type": "boolean"},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
              "status": {"enum": ["ok", "stale", "unavailable"]}
            }
          }
        },
        "budgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["budget_id", "currency", "remaining", "scope"],
            "properties": {
              "budget_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
              "currency": {"const": "USD"},
              "remaining": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
              "scope": {"const": "profile"}
            }
          }
        },
        "active_profile_class": {"enum": ["A", "B", "C"]},
        "local_control_is_account_wide": {"const": false},
        "surfaces_share_one_profile": {"const": true},
        "qualification_reference": {"const": "A"},
        "bounded_direct_authorized": {"const": false},
        "intervention": {"enum": ["stop", "reconciliation", "revocation"]},
        "recorded": {"type": "boolean"},
        "survives_restart": {"type": "boolean"},
        "restart_requires_reconciliation": {"const": true},
        "order_submitted": {"const": false},
        "export_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
        "chain_head_seq": {"type": "integer", "minimum": 0},
        "includes_refusals": {"type": "boolean"},
        "secrets_included": {"const": false},
        "reconciliation": {"enum": ["reconciled", "unreconciled"]},
        "unknown_orders": {"type": "integer", "minimum": 0},
        "restart_allowed": {"type": "boolean"},
        "bundle_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,64}$"},
        "contents": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status_code", "message", "recovery", "color_only"],
        "properties": {
          "code": {"enum": ["usage", "refused", "stale_or_unreconciled", "unavailable"]},
          "status_code": {"enum": ["usage", "refused", "stale_or_unreconciled", "unavailable"]},
          "message": {"type": "string", "minLength": 1},
          "recovery": {"type": "string", "minLength": 1},
          "color_only": {"const": false}
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "machine_readable",
        "ansi_in_machine_output",
        "color_only_signal",
        "text_status",
        "rendered"
      ],
      "properties": {
        "exit_code": {"enum": [0, 1, 2, 3, 4]},
        "machine_readable": {"type": "boolean"},
        "ansi_in_machine_output": {"type": "boolean"},
        "color_only_signal": {"type": "boolean"},
        "text_status": {"type": "string", "minLength": 1},
        "rendered": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"command": {"const": "operator.audit.export"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["export_id", "chain_head_seq", "includes_refusals", "secrets_included"]}}}},
    {"if": {"properties": {"command": {"const": "operator.budgets.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["budgets"]}}}},
    {"if": {"properties": {"command": {"const": "operator.decisions.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["decisions", "refusals"]}}}},
    {"if": {"properties": {"command": {"const": "operator.evidence.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["evidence_id", "source_id", "retrieved_at", "raw_ref", "summary_ref", "raw_separated_from_summary", "provenance"]}}}},
    {"if": {"properties": {"command": {"const": "operator.export.bundle"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["bundle_id", "contents", "secrets_included"]}}}},
    {"if": {"properties": {"command": {"const": "operator.health.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["watch_only", "stale", "dependencies"]}}}},
    {"if": {"properties": {"command": {"const": "operator.interventions.request_reconciliation"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["intervention", "recorded", "survives_restart", "restart_requires_reconciliation", "order_submitted"]}}}},
    {"if": {"properties": {"command": {"const": "operator.interventions.request_revocation"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["intervention", "recorded", "survives_restart", "restart_requires_reconciliation", "order_submitted"]}}}},
    {"if": {"properties": {"command": {"const": "operator.interventions.request_stop"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["intervention", "recorded", "survives_restart", "restart_requires_reconciliation", "order_submitted"]}}}},
    {"if": {"properties": {"command": {"const": "operator.positions.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["positions", "collateral"]}}}},
    {"if": {"properties": {"command": {"const": "operator.profiles.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["active_profile_class", "local_control_is_account_wide", "surfaces_share_one_profile", "qualification_reference", "bounded_direct_authorized"]}}}},
    {"if": {"properties": {"command": {"const": "operator.recovery.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["reconciliation", "unknown_orders", "restart_allowed", "restart_requires_reconciliation"]}}}},
    {"if": {"properties": {"command": {"const": "operator.strategies.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["strategy_id", "qualification", "baseline_id"]}}}},
    {"if": {"properties": {"command": {"const": "operator.uncertainty.inspect"}}, "required": ["command"]}, "then": {"properties": {"result": {"required": ["items"]}}}}
  ]
}
