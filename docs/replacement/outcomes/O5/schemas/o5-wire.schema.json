{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O5Wire",
  "$defs": {
    "task_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "provider_results_may_rewrite",
        "o4_consumption",
        "required_negative_ids",
        "cases"
      ],
      "properties": {
        "kind": {
          "const": "task_suite"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "provider_results_may_rewrite": {
          "const": false
        },
        "o4_consumption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fragment",
            "month_program_sha256",
            "o4_outcome_artifact",
            "o4_claimed_maturity",
            "provider_results_may_rewrite_protocol",
            "o4_population_artifact_frozen",
            "metrics",
            "floors",
            "non_substitutes",
            "checkpoint"
          ],
          "properties": {
            "fragment": {
              "const": "docs/replacement/MONTH-PROGRAM.md#o4"
            },
            "month_program_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "o4_outcome_artifact": {
              "const": "pending_outcome_artifact"
            },
            "o4_claimed_maturity": {
              "const": "researched"
            },
            "provider_results_may_rewrite_protocol": {
              "const": false
            },
            "o4_population_artifact_frozen": {
              "const": false
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 8
            },
            "floors": {
              "type": "object"
            },
            "non_substitutes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 5
            },
            "checkpoint": {
              "type": "string"
            }
          }
        },
        "required_negative_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "polarity",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "polarity": {
                "enum": [
                  "measurement",
                  "grounding",
                  "refusal"
                ]
              },
              "output_schema": {
                "type": "object"
              },
              "ground_truth": {
                "type": "object"
              },
              "output": {
                "type": "object"
              },
              "dispatched_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sources": {
                "type": "object"
              },
              "request_asks": {
                "type": "string"
              },
              "refusal_code": {
                "type": "string"
              },
              "order_emitted": {
                "type": "boolean"
              },
              "credential_emitted": {
                "type": "boolean"
              },
              "expected": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "capability_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "capabilities"
      ],
      "properties": {
        "kind": {
          "const": "capability_manifest"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "grants_authority",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "grants_authority": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "route_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "inspected_commit",
        "registry_baseline_commit",
        "routes"
      ],
      "properties": {
        "kind": {
          "const": "route_manifest"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "inspected_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "registry_baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "presence",
              "transport",
              "evidence_class",
              "qualification_claim",
              "installed_route_qualified",
              "order_authority",
              "broker_tools",
              "credentials_required_for_this_packet",
              "inv2_auto_pin",
              "schema_name",
              "source",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "presence": {
                "enum": [
                  "installed",
                  "not_installed"
                ]
              },
              "transport": {
                "type": "string"
              },
              "evidence_class": {
                "enum": [
                  "source_documented_fact",
                  "locally_observed",
                  "inference",
                  "simulation",
                  "demo_or_paper",
                  "shadow",
                  "limited_live",
                  "independently_verified",
                  "unmeasured"
                ]
              },
              "qualification_claim": {
                "const": "none"
              },
              "installed_route_qualified": {
                "const": false
              },
              "order_authority": {
                "const": false
              },
              "broker_tools": {
                "const": false
              },
              "credentials_required_for_this_packet": {
                "const": false
              },
              "inv2_auto_pin": {
                "type": "string"
              },
              "schema_name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "budget_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "spend_authorized",
        "paid_calls_executed",
        "entries"
      ],
      "properties": {
        "kind": {
          "const": "budget_ledger"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "spend_authorized": {
          "type": "boolean"
        },
        "paid_calls_executed": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "route_id",
              "metric",
              "ceiling",
              "unit",
              "source",
              "widening_allowed",
              "owner_decision"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "route_id": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "ceiling": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "widening_allowed": {
                "const": false
              },
              "owner_decision": {
                "const": "undecided"
              }
            }
          }
        }
      }
    },
    "privacy_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "status",
        "decided",
        "owner",
        "classes"
      ],
      "properties": {
        "kind": {
          "const": "privacy_disclosure"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "status": {
          "type": "string"
        },
        "decided": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "proposed_default",
              "admitted",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "proposed_default": {
                "type": "string"
              },
              "admitted": {
                "const": false
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "measure_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "measured",
        "measures"
      ],
      "properties": {
        "kind": {
          "const": "measure_report"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "measured": {
          "type": "boolean"
        },
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "may_offset_correctness",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "may_offset_correctness": {
                "type": "boolean"
              },
              "clearing_authority": {
                "type": "boolean"
              },
              "higher_is_worse": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "experiment_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "any_executed",
        "experiments"
      ],
      "properties": {
        "kind": {
          "const": "experiment_list"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "any_executed": {
          "type": "boolean"
        },
        "experiments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "route_id",
              "status",
              "executed",
              "uses_credentials",
              "paid_call",
              "uses_network",
              "blocked_on",
              "would_measure",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "route_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "listed_not_run",
                  "executed"
                ]
              },
              "executed": {
                "type": "boolean"
              },
              "uses_credentials": {
                "type": "boolean"
              },
              "paid_call": {
                "type": "boolean"
              },
              "uses_network": {
                "type": "boolean"
              },
              "blocked_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "would_measure": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "qualification_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "route_id",
        "presence",
        "transport",
        "evidence_class",
        "qualification_claim",
        "installed_route_qualified",
        "experiments_executed",
        "retained_outputs",
        "note"
      ],
      "properties": {
        "kind": {
          "const": "qualification_record"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "route_id": {
          "type": "string"
        },
        "presence": {
          "enum": [
            "installed",
            "not_installed"
          ]
        },
        "transport": {
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "source_documented_fact",
            "locally_observed",
            "inference",
            "simulation",
            "demo_or_paper",
            "shadow",
            "limited_live",
            "independently_verified",
            "unmeasured"
          ]
        },
        "qualification_claim": {
          "enum": [
            "none",
            "adapter_logic",
            "installed_route"
          ]
        },
        "installed_route_qualified": {
          "type": "boolean"
        },
        "experiments_executed": {
          "type": "boolean"
        },
        "retained_outputs": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "fallback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "primary",
        "fallback",
        "on_trigger",
        "effect"
      ],
      "properties": {
        "kind": {
          "const": "fallback_policy"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_id",
            "authority_ceiling",
            "max_cost_usd",
            "max_latency_ms",
            "disclosure_classes",
            "broker_tools"
          ],
          "properties": {
            "route_id": {
              "type": "string"
            },
            "authority_ceiling": {
              "enum": [
                "evidence_only",
                "proposal_only",
                "model_assisted",
                "bounded_direct",
                "order_submission",
                "broker_tool"
              ]
            },
            "max_cost_usd": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            "max_latency_ms": {
              "type": "integer",
              "minimum": 0
            },
            "disclosure_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "broker_tools": {
              "type": "boolean"
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_id",
            "authority_ceiling",
            "max_cost_usd",
            "max_latency_ms",
            "disclosure_classes",
            "broker_tools"
          ],
          "properties": {
            "route_id": {
              "type": "string"
            },
            "authority_ceiling": {
              "enum": [
                "evidence_only",
                "proposal_only",
                "model_assisted",
                "bounded_direct",
                "order_submission",
                "broker_tool"
              ]
            },
            "max_cost_usd": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            "max_latency_ms": {
              "type": "integer",
              "minimum": 0
            },
            "disclosure_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "broker_tools": {
              "type": "boolean"
            }
          }
        },
        "on_trigger": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "effect": {
          "type": "string"
        }
      }
    },
    "route_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "issue",
        "claimed_maturity",
        "not_claimed",
        "qualification_claimed",
        "empirical_pass_claimed",
        "contract_frozen_claimed",
        "baseline",
        "candidate",
        "decision",
        "qualification_claim",
        "measures_are_observed",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "route_comparison"
        },
        "schema_version": {
          "const": "o5.candidate.v1"
        },
        "issue": {
          "const": "CSL-217"
        },
        "claimed_maturity": {
          "const": "researched"
        },
        "not_claimed": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "qualification_claimed": {
          "const": false
        },
        "empirical_pass_claimed": {
          "const": false
        },
        "contract_frozen_claimed": {
          "const": false
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_id",
            "correctness",
            "grounding",
            "calibration_ece",
            "cost_usd",
            "latency_ms_p95"
