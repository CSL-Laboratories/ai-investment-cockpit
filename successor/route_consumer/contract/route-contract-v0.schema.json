    "Timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string",
      "x-rfc3339Utc": true
    },
    "Token": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[^/ ]+$",
      "type": "string"
    },
    "TriState": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "UsageState": {
      "enum": [
        "degraded",
        "exhausted",
        "ok"
      ]
    },
    "Version": {
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]{0,95}$",
      "type": "string",
      "x-utf8MaxBytes": 96
    }
  },
