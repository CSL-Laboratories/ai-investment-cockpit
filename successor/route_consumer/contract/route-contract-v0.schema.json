        },
        "repaired": {
          "type": "boolean"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "enum": [
            "limit_hit",
            "needs_human_review",
            "ok",
            "timeout"
          ]
        },
        "termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessTerminationObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "RouteExecutionResult@0"
        },
        "usage_state": {
          "$ref": "#/$defs/UsageState"
        },
        "validated": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "request_id",
        "status",
        "error",
        "dispatched",
        "repaired",
        "usage_state",
        "output_digest",
        "validated",
        "health_event",
        "termination"
      ],
      "type": "object"
    },
    "RouteHealthEvent": {
      "additionalProperties": false,
      "properties": {
        "engine_id": {
          "$ref": "#/$defs/EngineProfile"
        },
        "error": {
          "$ref": "#/$defs/ErrorToken"
        },
        "state": {
          "enum": [
            "degraded",
            "exhausted"
          ]
