        "engine_id",
        "state",
        "error"
      ],
      "type": "object"
    },
    "RouteRefusal": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/RefusalCode"
        },
        "dispatched": {
          "const": false
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "const": "RouteRefusal@0"
        }
      },
      "required": [
        "type",
        "request_id",
        "code",
        "dispatched"
      ],
      "type": "object"
    },
    "RouteRequirement": {
      "additionalProperties": false,
      "properties": {
        "allowed_billing": {
          "$ref": "#/$defs/BillingBasisSet"
        },
        "allowed_egress_destinations": {
          "$ref": "#/$defs/OpaqueRefSet"
        },
        "allowed_host_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "allowed_route_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "estimated_metered_microunits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Microunits"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "max_metered_microunits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Microunits"
            },
            {
              "type": "null"
            }
          ]
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "required_capabilities": {
          "$ref": "#/$defs/NonEmptyIdSet"
        },
        "required_sandbox_capabilities": {
          "$ref": "#/$defs/IdSet"
        },
        "type": {
          "const": "RouteRequirement@1"
        }
      },
      "required": [
        "type",
        "id",
        "required_capabilities",
        "privacy_class",
        "allowed_billing",
        "allowed_route_ids",
        "allowed_host_ids",
        "allowed_egress_destinations",
        "estimated_metered_microunits",
        "max_metered_microunits",
        "required_sandbox_capabilities"
      ],
      "type": "object"
    },
    "SandboxDescriptor": {
      "additionalProperties": false,
      "properties": {
        "allowed_destinations": {
          "$ref": "#/$defs/OpaqueRefSet"
        },
        "allowed_paths": {
          "$ref": "#/$defs/OpaqueRefSet"
        },
        "capabilities": {
          "$ref": "#/$defs/IdSet"
        },
        "filesystem_mode": {
          "enum": [
            "none",
            "read-only",
            "workspace-write",
            "full"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "network_mode": {
          "enum": [
            "denied",
            "allowlist",
            "full"
          ]
        },
        "process_mode": {
          "enum": [
            "denied",
            "isolated",
            "full"
          ]
        },
        "type": {
          "const": "SandboxDescriptor@1"
