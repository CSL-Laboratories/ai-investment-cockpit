              "state": {
                "const": "supported"
              }
            }
          },
          "if": {
            "properties": {
              "adapter_kind": {
                "const": "live"
              }
            },
            "required": [
              "adapter_kind"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": "awaiting-csl-460"
              },
              "state": {
                "const": "unsupported"
              }
            }
          }
